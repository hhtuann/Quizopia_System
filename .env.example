# Quizopia_System Docker Compose environment TEMPLATE (never commit .env).
# Copy to .env in the System repository root and supply your own secrets.
# docker compose automatically reads THIS root .env for ${...} substitutions.
# No backend/.env is required when launching through this Compose stack.
# After changes: docker compose up -d --no-deps --force-recreate backend

# REQUIRED for backend security. Keep existing keys stable if encrypted data exists.
# Generate a NEW JWT key with: openssl rand -base64 48
QUIZOPIA_JWT_SECRET_BASE64=__replace_with_base64_of_at_least_32_random_bytes__
# Generate a NEW AES-256-GCM key with: openssl rand -base64 32
QUIZOPIA_DATA_ENCRYPTION_KEY_BASE64=__replace_with_base64_of_exactly_32_random_bytes__
QUIZOPIA_ALLOWED_ORIGINS=http://localhost:3000
QUIZOPIA_COOKIE_SECURE=false

# Docker Compose frontend build argument (browser-reachable backend).
# Use port 8181 here ONLY if the browser actually reaches a backend at 8181.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Identity M1 / M5: mail, password reset and optional Google OAuth.
# The backend is INSIDE Docker: host=mailpit (not localhost).
QUIZOPIA_SMTP_HOST=mailpit
QUIZOPIA_SMTP_PORT=1025
QUIZOPIA_MAIL_FROM=Quizopia <no-reply@quizopia.local>
QUIZOPIA_PASSWORD_RESET_FRONTEND_BASE_URI=http://localhost:3000

# Leave empty to disable Google login. Backend-only client secret!
QUIZOPIA_GOOGLE_CLIENT_ID=
QUIZOPIA_GOOGLE_CLIENT_SECRET=
QUIZOPIA_OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
QUIZOPIA_OAUTH_REDIRECT_BASE_URI=http://localhost:8080

# Local-only demo seed; NEVER enable for production.
QUIZOPIA_DEMO_DATA_ENABLED=false

# ---------------------------------------------------------------------------
# MinIO (core). Root credentials of the quizopia_minio container. If an
# existing minio_data volume was created with different credentials, put
# THOSE values here — changing them locks existing evidence objects away.
# In this dev setup the same pair doubles as the backend evidence credentials
# (QUIZOPIA_EVIDENCE_MINIO_* below); keep the two pairs identical.
QUIZOPIA_MINIO_ROOT_USER=minioadmin
QUIZOPIA_MINIO_ROOT_PASSWORD=minioadmin123

# Phase 4 monitoring/camera/evidence — camera path OFF by default.
# Start LiveKit with: docker compose --profile monitoring up -d --build
# (add --profile recording for Egress). The SAME key/secret pair is used by
# the backend, the SFU and Egress; generate once with: openssl rand -hex 24
QUIZOPIA_AI_INGEST_KEY=
QUIZOPIA_LIVEKIT_ENABLED=false
QUIZOPIA_LIVEKIT_API_KEY=devquizopia
QUIZOPIA_LIVEKIT_API_SECRET=__replace_with_openssl_rand_hex_24__
# Server->SFU Twirp RoomService: Docker service DNS inside the unified stack.
QUIZOPIA_LIVEKIT_HTTP_URL=http://livekit:7880
# Handed to BROWSERS with join tokens: must be reachable from the browser,
# never a Docker-internal hostname. Use ws://<host-LAN-IP>:7880 for LAN demos.
QUIZOPIA_LIVEKIT_WS_URL=ws://localhost:7880
# Backend -> MinIO (service DNS) and the S3 endpoint the backend passes to
# the Egress container inside recording requests (also service DNS).
QUIZOPIA_EVIDENCE_MINIO_ENDPOINT=http://minio:9000
QUIZOPIA_EVIDENCE_MINIO_EGRESS_ENDPOINT=http://minio:9000
# Base URL baked into presigned teacher playback URLs — must be reachable
# from the BROWSER (host-published MinIO), unlike the two endpoints above.
QUIZOPIA_EVIDENCE_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
QUIZOPIA_EVIDENCE_MINIO_ACCESS_KEY=minioadmin
QUIZOPIA_EVIDENCE_MINIO_SECRET_KEY=minioadmin123
QUIZOPIA_EVIDENCE_BUCKET=quizopia-evidence
QUIZOPIA_FFMPEG_COMMAND=ffmpeg

# LiveKit SFU tuning (monitoring profile). Defaults match the published
# ports in docker-compose.yml — override only when needed.
# Signed webhook target; use http://host.docker.internal:8080/internal/media/v1/livekit/webhooks
# when the backend runs directly on the host (E2E workflows).
LIVEKIT_WEBHOOK_URL=http://backend:8080/internal/media/v1/livekit/webhooks
# ICE candidates advertise 127.0.0.1 for browsers on the Docker host;
# set the host LAN IP for LAN demos (README "LAN demo" section).
LIVEKIT_RTC_NODE_IP=127.0.0.1
# WebRTC ICE/UDP media range. On Windows, Hyper-V dynamic port exclusions
# (netsh interface ipv4 show excludedportrange protocol=udp) can cover the
# default range after a reboot; move BOTH values together to a free range.
LIVEKIT_RTC_PORT_START=50100
LIVEKIT_RTC_PORT_END=50200

# Phase 5 (planned): OpenAI-backed AI Quiz Markdown Assistant.
# Key MUST remain server-side, never NEXT_PUBLIC_ or frontend .env.local.
# A valid key alone does not enable Phase 5 before code is implemented.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
