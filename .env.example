# ============================================================
# Quizopia environment variables (TEMPLATE ONLY).
#
# Copy this file to ".env" in the repository root and replace the
# placeholder values with real secrets generated locally. NEVER
# commit a real ".env" file. These values are read by docker-compose
# and passed to the backend service.
# ============================================================

# HS256 JWT signing key: Base64 encoding of AT LEAST 32 random bytes.
# Generate with:
#   openssl rand -base64 48
QUIZOPIA_JWT_SECRET_BASE64=__replace_with_base64_of_at_least_32_random_bytes__

# AES-256-GCM data-encryption key: Base64 encoding of EXACTLY 32 random bytes.
# Generate with:
#   openssl rand -base64 32
QUIZOPIA_DATA_ENCRYPTION_KEY_BASE64=__replace_with_base64_of_exactly_32_random_bytes__

# DEPRECATED (Identity-M1): public registration is STUDENT-only and the
# teacher invite code is no longer used. Teachers self-register the capability
# in-app after signing in (Identity-M2). The variable is ignored if present.
# QUIZOPIA_TEACHER_INVITE_CODE=

# Comma-separated list of allowed CORS origins.
QUIZOPIA_ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" in production to mark refresh cookies as Secure.
QUIZOPIA_COOKIE_SECURE=false

# ============================================================
# Identity-M1: OTP mail transport (verification emails).
# Local stack: Mailpit (compose service) on localhost:1025.
# Production: your SMTP provider.
# ============================================================
QUIZOPIA_SMTP_HOST=localhost
QUIZOPIA_SMTP_PORT=1025
QUIZOPIA_MAIL_FROM=Quizopia <no-reply@quizopia.local>

# ============================================================
# Identity-M1: Google OIDC login (OPTIONAL — leave empty to disable;
# the login button is hidden until configured).
#
# Setup (Google Cloud Console):
#   1. APIs & Services → Credentials → Create OAuth client ID (Web application).
#   2. Authorized redirect URI: <backend-base-url>/api/auth/oauth/google/callback
#      (e.g. http://localhost:8080/api/auth/oauth/google/callback)
#   3. Copy the client id/secret here. NEVER expose the secret to the frontend.
# ============================================================
QUIZOPIA_GOOGLE_CLIENT_ID=
QUIZOPIA_GOOGLE_CLIENT_SECRET=
# Absolute browser URL of the SPA OAuth callback page.
QUIZOPIA_OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
# Base URL of this backend as reachable by Google (redirect_uri is base + path).
QUIZOPIA_OAUTH_REDIRECT_BASE_URI=http://localhost:8080

# Seed demo accounts (one per role: sysadmin, academic admin, teacher, 4 students)
# plus a demo classroom on the backend's first startup. Set to "true" to try the
# app quickly; leave "false" for production. Demo password: Demo@12345.
QUIZOPIA_DEMO_DATA_ENABLED=false
